# Orchestrator
ONCALL_TOKEN=replace-with-long-random-string
ONCALL_PORT=8765
ONCALL_DB_PATH=~/.oncall/state.db
ONCALL_PROD_HOSTS=

# Operator (the small model that talks to the user and routes work).
# Default backend is "gemini" (Google AI Studio native API) — required for
# ack-first behavior on gemma-4-31b-it (the Vercel gateway's gemma routing
# strips assistant text when a tool_call is in the same response, which
# kills our latency optimization). Set to "vercel" to use the OpenAI-
# compatible Vercel AI Gateway instead (needed for non-Google models like
# zai/glm-4.7-flash or minimax/*).
ONCALL_OPERATOR_BACKEND=gemini
ONCALL_OPERATOR_MODEL=google/gemma-4-31b-it
# "minimal" cuts TTFA ~7s→1s by suppressing the model's default internal
# monologue. Leave unset for default ("HIGH") if you need more reasoning.
ONCALL_OPERATOR_REASONING_EFFORT=minimal

# Gemini backend — Google AI Studio. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Vercel gateway — only used when ONCALL_OPERATOR_BACKEND=vercel, OR as
# the embedder when ONCALL_MEMORY_EMBED_MODEL is a vendor-prefixed slug
# (e.g. "alibaba/qwen3-embedding-8b"). https://vercel.com/dashboard/ai-gateway/api-keys
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN is set automatically on Vercel deployments; used as fallback.

# Memory embedder. Default uses local Ollama (~30× faster than the gateway
# path). Override to e.g. "alibaba/qwen3-embedding-8b" if you don't want
# to run Ollama on this host. Pull the default model first:
#   ollama pull nomic-embed-text:137m-v1.5-fp16
ONCALL_MEMORY_EMBED_MODEL=nomic-embed-text:137m-v1.5-fp16
ONCALL_OLLAMA_HOST=http://localhost:11434

# Executor (Claude CLI) — uses whatever auth `claude` already has on the host
# (keychain OAuth for subscription users, or ANTHROPIC_API_KEY in your shell
# env if you prefer a workspace API key). Nothing to configure here.

# Telegram BOT — chat with the operator via a real Telegram bot.
# Uses the HTTP Bot API: token + owner user_id are all you need.
# 1. Create a bot via @BotFather; paste its token below.
# 2. Get your own numeric user_id from @userinfobot — only that id may DM
#    the bot; everyone else is silently ignored.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_OWNER_ID=

# Telegram USERBOT (optional, separate from bot above). MTProto userbot for
# reading inbound DMs from arbitrary senders for triage + reply-by-proposal.
# Requires registering an app at https://my.telegram.org/apps.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=~/.oncall/telegram.session
TELEGRAM_IMPORTANT_SENDERS=
TELEGRAM_IMPORTANT_KEYWORDS=urgent,down,production,outage,critical
# Comma-separated @usernames the userbot must never surface. The own bot
# from TELEGRAM_BOT_TOKEN is auto-added by user_id; this is for extras.
TELEGRAM_USERBOT_IGNORE_USERNAMES=
