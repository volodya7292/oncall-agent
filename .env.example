# Orchestrator
ONCALL_TOKEN=replace-with-long-random-string
ONCALL_PORT=8765
ONCALL_DB_PATH=~/.oncall/state.db
ONCALL_PROD_HOSTS=

# Operator (the small model that talks to the user and routes work).
# Default: openai/gpt-oss-120b via OpenRouter ("openrouter" backend), pinned
# to fast providers. Measured ~0.26s TTFT on Groq with the real operator
# prompt (target is <=0.6s), ~$0.15/Mtok in — ~10x cheaper than claude-haiku.
# OpenRouter auto-caches on capable providers (Groq/DeepSeek), no plumbing.
#   ONCALL_OPERATOR_BACKEND=anthropic -> native Claude API (claude-haiku-4-5)
#   ONCALL_OPERATOR_BACKEND=gemini    -> native AI Studio (Google; ack-first)
#   ONCALL_OPERATOR_BACKEND=vercel    -> Vercel AI Gateway (OpenAI-compatible)
ONCALL_OPERATOR_BACKEND=openrouter
ONCALL_OPERATOR_MODEL=openai/gpt-oss-120b
# OpenRouter provider preference (comma-separated, highest first). Fallbacks
# stay on, so it drops to the next if the top provider rate-limits. These are
# the sub-0.5s TTFT providers measured for gpt-oss-120b; retune per model.
ONCALL_OPERATOR_PROVIDER_ORDER=Groq,Cerebras,BaseTen
# Reasoning level. "low" keeps gpt-oss fast (~0.26s TTFT) while helping tool
# routing. "minimal" is not accepted by all reasoning models; "low" is the
# portable low-latency floor. "medium"/"high" trade latency for depth.
ONCALL_OPERATOR_REASONING_EFFORT=low

# OpenRouter backend — get a key at https://openrouter.ai/settings/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Anthropic backend — Claude API. Get a key at https://console.anthropic.com/settings/keys
# Also usable by the executor CLI if it has no other auth (see below).
ANTHROPIC_API_KEY=

# Gemini backend — Google AI Studio. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Vercel gateway — only used when ONCALL_OPERATOR_BACKEND=vercel, OR as
# the embedder when ONCALL_MEMORY_EMBED_MODEL is a vendor-prefixed slug
# (e.g. "alibaba/qwen3-embedding-8b"). https://vercel.com/dashboard/ai-gateway/api-keys
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN is set automatically on Vercel deployments; used as fallback.

# Memory embedder. Default uses local Ollama (~30× faster than the gateway
# path). Override to e.g. "alibaba/qwen3-embedding-8b" if you don't want
# to run Ollama on this host. Pull the default model first:
#   ollama pull embeddinggemma:300m
ONCALL_MEMORY_EMBED_MODEL=embeddinggemma:300m
ONCALL_OLLAMA_HOST=http://localhost:11434

# Executor (Claude CLI) — uses whatever auth `claude` already has on the host
# (keychain OAuth for subscription users, or ANTHROPIC_API_KEY in your shell
# env if you prefer a workspace API key). Nothing to configure here.

# Telegram — two userbot sessions sharing one application credential.
# 1. Register an application at https://my.telegram.org/apps; the same
#    api_id/api_hash drives both sessions (they're distinguished only by
#    session-file path — credentials identify the APP, not the account).
# 2. PRIMARY userbot (your own Telegram account). Reads inbound DMs from
#    third parties for triage + reply-on-your-behalf. Provision with:
#      oncall telegram-login
# 3. AGENT userbot. A SECOND Telegram account dedicated to the agent — this
#    is the user-facing chat surface (you DM it, you call it). Provision with:
#      oncall telegram-login --agent
# 4. TELEGRAM_OWNER_USER_ID = your primary account's numeric user_id (from
#    @userinfobot). The agent userbot accepts messages only from that id.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=~/.oncall/telegram.session
TELEGRAM_AGENT_SESSION_PATH=~/.oncall/telegram_agent.session
TELEGRAM_OWNER_USER_ID=

# Voice calls (optional). When VOICE_CALL_ENABLED=1, the agent userbot's
# telethon session also binds py-tgcalls so the OWNER can place 1:1
# voice calls to the agent. STT and TTS endpoints must be OpenAI-compatible,
# Opus-only, bearer-token auth. Voice and text chat share the same
# operator session (`chat_messages` row is the same).
VOICE_CALL_ENABLED=0
VOICE_STT_BASE_URL=
VOICE_STT_API_KEY=
VOICE_TTS_BASE_URL=
VOICE_TTS_VOICE=serhii
VOICE_TTS_API_KEY=

# Operator (and executor) reply language — ISO-639-1, e.g. "uk", "en", "ru".
# Injected into both system prompts at daemon startup AND used as the STT
# language hint during voice calls. Empty = no forcing (operator matches the
# user's last message; STT auto-detects).
OPERATOR_LANGUAGE=

# Name the operator uses to refer to itself in chats / voice calls.
# Default: "On-call agent".
AGENT_NAME=
